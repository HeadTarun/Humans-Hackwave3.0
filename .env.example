# Supabase (Phase 2 — required for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# Resource limits
MAX_REPO_SIZE_MB=100
MAX_EXTRACTED_SIZE_MB=200
MAX_REPO_FILES=5000

# Phase 3: E2B Sandbox (required for real execution; leave empty to use FakeSandboxRunner)
# E2B_API_KEY=e2b_xxxxxxxxxxxxxxxxxxxx
# E2B_TEMPLATE_ID=             # Optional custom sandbox template
# E2B_TIMEOUT_SECONDS=300      # Max sandbox lifetime

# Phase 3: Evidence Storage (uses FakeArtifactStore if Supabase not configured)
# EVIDENCE_BUCKET=evidence-artifacts

# Phase 4+
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
