# =============================================================================
# HealTest Backend — Production Environment Variables Reference
# =============================================================================

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=generate-a-strong-random-secret-key-here
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Supabase (Postgres & Private Storage)
# Required for production persistence and private artifact storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-auth-token-verification
EVIDENCE_BUCKET=evidence-artifacts

# Execution & Diagnosis Tools
# E2B Sandbox for isolated code execution & app startup
E2B_API_KEY=e2b_your_api_key_here
E2B_TIMEOUT_SECONDS=300
# E2B_TEMPLATE_ID=optional-custom-template-id

# Groq API for ambiguous failure classification & repair proposals
GROQ_API_KEY=gsk_your_groq_api_key_here

# Resource Limits
MAX_REPO_SIZE_MB=100
MAX_EXTRACTED_SIZE_MB=200
MAX_REPO_FILES=5000
MAX_RUN_DURATION_SECONDS=300
MAX_CONCURRENT_RUNS=5
